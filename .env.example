# Stripe
STRIPE_SECRET_KEY=sk_test_...
# Set this to the whsec_... printed by `stripe listen ...`
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional: pin Stripe API version (good practice)
STRIPE_API_VERSION=2024-06-20

# Your Stripe Price ID (created in Stripe dashboard, e.g. price_123)
STRIPE_PRICE_ID=price_...

# (optional) used only if you run locally outside compose
DATABASE_URL=postgres://app:app@localhost:5432/app